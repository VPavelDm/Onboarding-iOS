    "Your purchase needs to be approved. The app will unlock automatically once that happens." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج الشراء إلى موافقة. سيتم فتح التطبيق تلقائيًا فور الموافقة عليه."
          }
